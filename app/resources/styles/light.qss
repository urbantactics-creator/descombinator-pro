/* Light theme stylesheet for Descombinator Pro */

/* Main window and widgets */
QMainWindow {
    background-color: #f0f0f0;
    color: #000000;
}

QWidget {
    background-color: #f0f0f0;
    color: #000000;
    font-size: 10pt;
}

/* Group boxes */
QGroupBox {
    font-weight: bold;
    border: 2px solid #cccccc;
    border-radius: 5px;
    margin-top: 1ex;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* Buttons */
QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #d0d0d0;
    border: 1px solid #a0a0a0;
}

QPushButton:pressed {
    background-color: #c0c0c0;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #a0a0a0;
    border: 1px solid #d0d0d0;
}

/* Primary button */
QPushButton#primaryButton {
    background-color: #4CAF50;
    border: 1px solid #388E3C;
    color: #ffffff;
    font-weight: 600;
    padding: 8px 24px;
    border-radius: 6px;
    min-width: 100px;
}

QPushButton#primaryButton:hover {
    background-color: #66BB6A;
    border: 1px solid #4CAF50;
}

QPushButton#primaryButton:pressed {
    background-color: #388E3C;
}

QPushButton#primaryButton:disabled {
    background-color: #2E7D32;
    color: #888888;
    border: 1px solid #1B5E20;
}

/* Check boxes */
QCheckBox {
    spacing: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #999999;
    background-color: #ffffff;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 2px solid #4CAF50;
    background-color: #4CAF50;
    border-radius: 3px;
    image: url(:/icons/check.png);
}

/* Combo boxes */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QComboBox:hover {
    border: 1px solid #909090;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #b0b0b0;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(:/icons/dropdown.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    selection-background-color: #d0d0d0;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #999999;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 1px solid #777777;
}

QSlider::handle:horizontal:pressed {
    background: #ffffff;
    border: 1px solid #555555;
}

QSlider::sub-page:horizontal {
    background: #4CAF50;
    border-radius: 3px;
}

/* Progress bars */
QProgressBar {
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    text-align: center;
    background-color: #ffffff;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #000000;
}

/* Line edits */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    padding: 6px;
    color: #000000;
}

QLineEdit:focus {
    border: 1px solid #4CAF50;
}

/* Text edits */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    color: #000000;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #b0b0b0;
    background-color: #f0f0f0;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #666666;
    border: 1px solid #b0b0b0;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #f0f0f0;
    color: #000000;
    border-bottom: 2px solid #4CAF50;
}

QTabBar::tab:hover:!selected {
    background-color: #d0d0d0;
    color: #000000;
}

/* Menu bar */
QMenuBar {
    background-color: #f0f0f0;
    color: #000000;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #e0e0e0;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    color: #000000;
}

QMenu::item {
    padding: 4px 24px 4px 20px;
}

QMenu::item:selected {
    background-color: #e0e0e0;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background: #d0d0d0;
    margin: 4px 0px;
}

/* Status bar */
QStatusBar {
    background-color: #f0f0f0;
    color: #666666;
    border-top: 1px solid #b0b0b0;
}

/* File drop zone */
FileDropZone {
    border: 2px dashed #cccccc;
    border-radius: 8px;
    background-color: #ffffff;
}

FileDropZone:hover {
    border-color: #999999;
    background-color: #f8f8f8;
}

/* Waveform view */
WaveformView {
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
}
