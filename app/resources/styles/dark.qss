/* Dark theme stylesheet for Descombinator Pro */

/* Main window and widgets */
QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}

QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    font-size: 10pt;
}

/* Group boxes */
QGroupBox {
    font-weight: bold;
    border: 2px solid #555555;
    border-radius: 5px;
    margin-top: 1ex;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* Buttons */
QPushButton {
    background-color: #4a4a4a;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #5a5a5a;
    border: 1px solid #777777;
}

QPushButton:pressed {
    background-color: #3a3a3a;
}

QPushButton:disabled {
    background-color: #333333;
    color: #777777;
    border: 1px solid #555555;
}

/* Check boxes */
QCheckBox {
    spacing: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #777777;
    background-color: #2b2b2b;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 2px solid #4CAF50;
    background-color: #4CAF50;
    border-radius: 3px;
    image: url(:/icons/check.png);
}

/* Combo boxes */
QComboBox {
    background-color: #4a4a4a;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QComboBox:hover {
    border: 1px solid #777777;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #666666;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    image: url(:/icons/dropdown.png);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #4a4a4a;
    border: 1px solid #666666;
    selection-background-color: #5a5a5a;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #4a4a4a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #777777;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 1px solid #999999;
}

QSlider::handle:horizontal:pressed {
    background: #ffffff;
    border: 1px solid #bbbbbb;
}

QSlider::sub-page:horizontal {
    background: #4CAF50;
    border-radius: 3px;
}

/* Progress bars */
QProgressBar {
    border: 1px solid #555555;
    border-radius: 4px;
    text-align: center;
    background-color: #3a3a3a;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 3px;
}

/* Labels */
QLabel {
    color: #ffffff;
}

/* Line edits */
QLineEdit {
    background-color: #4a4a4a;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px;
    color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #4CAF50;
}

/* Text edits */
QTextEdit {
    background-color: #3a3a3a;
    border: 1px solid #555555;
    border-radius: 4px;
    color: #ffffff;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #555555;
    background-color: #2b2b2b;
}

QTabBar::tab {
    background-color: #3a3a3a;
    color: #cccccc;
    border: 1px solid #555555;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #ffffff;
    border-bottom: 2px solid #4CAF50;
}

QTabBar::tab:hover:!selected {
    background-color: #4a4a4a;
    color: #ffffff;
}

/* Menu bar */
QMenuBar {
    background-color: #2b2b2b;
    color: #ffffff;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #3a3a3a;
    border-radius: 4px;
}

QMenu {
    background-color: #3a3a3a;
    border: 1px solid #555555;
    color: #ffffff;
}

QMenu::item {
    padding: 4px 24px 4px 20px;
}

QMenu::item:selected {
    background-color: #4a4a4a;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background: #555555;
    margin: 4px 0px;
}

/* Status bar */
QStatusBar {
    background-color: #2b2b2b;
    color: #cccccc;
    border-top: 1px solid #555555;
}

/* File drop zone */
FileDropZone {
    border: 2px dashed #555555;
    border-radius: 8px;
    background-color: #3a3a3a;
}

FileDropZone:hover {
    border-color: #777777;
    background-color: #424242;
}

/* Waveform view */
WaveformView {
    background-color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
}
